  "homepage": "https://github.com/shanmiteko/AutoScript#readme",
  "dependencies": {
    "chalk": "^4.1.2",
    "http-proxy-agent": "^7.0.0",
    "https-proxy-agent": "^7.0.0",
    "nodemailer": "^6.7.0",
