#!/usr/bin/env bash
set -u

WORKER_MODE="${1:-}"
if [ "$WORKER_MODE" != "--worker" ]; then
  unit_suffix="${LOTTERY_UPDATE_JOB_ID:-$(date -u +%s)}"
  exec /usr/bin/systemd-run \
    --unit="lottery-web-update-$unit_suffix" \
    --collect \
    --no-block \
    --property=Type=oneshot \
    --setenv="LOTTERY_UPDATE_JOB_ID=$unit_suffix" \
    /usr/local/sbin/lottery-web-update --worker
fi

APP_DIR="/opt/bili-dynamic-lottery"
SERVICE_NAME="lottery-web.service"
DATA_DIR="$APP_DIR/data"
STATE_FILE="$DATA_DIR/update-state.json"
LOG_FILE="$DATA_DIR/update.log"
BACKUP_DIR="$DATA_DIR/update-backups/$(date -u +%Y%m%dT%H%M%SZ)"
PACKAGE_DIR="$DATA_DIR/update-packages"
PACKAGE_FILE="$PACKAGE_DIR/pending.tar.gz"
PACKAGE_METADATA="$PACKAGE_DIR/pending.json"
OLD_COMMIT=""
OLD_DEPLOYED_COMMIT=""
NEW_COMMIT=""
PACKAGE_MODE="false"
TMP_DIR=""

# 服务单元启用了 ProtectHome=true，sudo 子进程看不到 /root。
# npm 若继续使用 /root/.npm 会报 ENOENT，并在清理 node_modules 后安装失败。
# 因此固定使用独立、可写的 HOME/缓存目录，并显式指定国内镜像。
export HOME="/var/lib/lottery-web-home"
export npm_config_cache="/var/cache/lottery-web-npm"
export npm_config_registry="https://mirrors.tencentyun.com/npm"
mkdir -p "$HOME" "$npm_config_cache"

mkdir -p "$DATA_DIR" "$BACKUP_DIR"
touch "$LOG_FILE"
exec >>"$LOG_FILE" 2>&1

log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

validate_archive_entries() {
  local archive="$1"
  if tar -tzf "$archive" | grep -Eq '(^/|(^|/)\.\.(/|$)|^data(/|$)|^\.git(/|$))'; then
    return 1
  fi
}

deploy_archive() {
  local archive="$1" source_dir
  TMP_DIR="$(mktemp -d)"
  trap 'rm -rf "$TMP_DIR"' EXIT
  source_dir="$TMP_DIR/source"
  mkdir -p "$source_dir"
  validate_archive_entries "$archive" || rollback "发布包包含不允许的路径"
  tar -xzf "$archive" -C "$source_dir" || rollback "解压发布包失败"
  [ -f "$source_dir/package.json" ] || rollback "发布包缺少 package.json"
  [ -f "$source_dir/server/index.ts" ] || rollback "发布包缺少服务端源码"
  git -C "$APP_DIR" ls-files -z | xargs -0 -r rm -f
  cp -a "$source_dir"/. "$APP_DIR/"
  git -C "$APP_DIR" add -A
  if ! git -C "$APP_DIR" diff --cached --quiet; then
    git -C "$APP_DIR" -c user.name=lottery-web -c user.email=lottery-web@localhost commit -m "deploy: local package $NEW_COMMIT" || rollback "写入源码快照失败"
  fi
}

prepare_local_package() {
  local values expected_sha expected_size actual_sha actual_size
  values="$(UPDATE_PACKAGE_METADATA="$PACKAGE_METADATA" node - <<'NODE'
const fs = require('fs');
const value = JSON.parse(fs.readFileSync(process.env.UPDATE_PACKAGE_METADATA, 'utf8'));
if (!/^[a-f0-9]{40}$/i.test(String(value.commit || ''))) process.exit(2);
if (!/^[a-f0-9]{64}$/i.test(String(value.sha256 || ''))) process.exit(3);
if (!Number.isSafeInteger(Number(value.size)) || Number(value.size) < 512) process.exit(4);
process.stdout.write(`${String(value.commit).toLowerCase()} ${String(value.sha256).toLowerCase()} ${Number(value.size)}`);
NODE
)" || rollback "发布包元数据无效"
  read -r NEW_COMMIT expected_sha expected_size <<<"$values"
  actual_sha="$(sha256sum "$PACKAGE_FILE" | awk '{print $1}')" || rollback "无法校验发布包"
  actual_size="$(stat -c '%s' "$PACKAGE_FILE")" || rollback "无法读取发布包大小"
  [ "$actual_sha" = "$expected_sha" ] || rollback "发布包 SHA-256 校验失败"
  [ "$actual_size" = "$expected_size" ] || rollback "发布包大小校验失败"
}

wait_for_url() {
  local url="$1"
  local attempts=30
  while [ "$attempts" -gt 0 ]; do
    if curl -fsS --max-time 2 "$url" >/dev/null 2>&1; then return 0; fi
    attempts=$((attempts - 1))
    sleep 1
  done
  return 1
}

write_state() {
  local status="$1" error="${2:-}" rollback="${3:-false}" deployed="${4:-}"
  UPDATE_STATE_FILE="$STATE_FILE" UPDATE_STATUS="$status" UPDATE_ERROR="$error" UPDATE_COMMIT="${NEW_COMMIT:-$OLD_COMMIT}" UPDATE_DEPLOYED="$deployed" UPDATE_ROLLBACK="$rollback" node - <<'NODE'
const fs = require('fs');
const file = process.env.UPDATE_STATE_FILE;
let current = {};
try { current = JSON.parse(fs.readFileSync(file, 'utf8')); } catch {}
const deployed = process.env.UPDATE_DEPLOYED || undefined;
const next = { ...current, status: process.env.UPDATE_STATUS, error: process.env.UPDATE_ERROR || undefined, currentCommit: deployed || process.env.UPDATE_COMMIT || undefined, rollback: process.env.UPDATE_ROLLBACK === 'true', finishedAt: new Date().toISOString() };
if (deployed) next.deployedCommit = deployed;
if (next.status === 'success' && deployed) next.remoteCommit = deployed;
if (next.status === 'running') next.startedAt = new Date().toISOString();
fs.writeFileSync(file, JSON.stringify(next, null, 2));
NODE
  chown lottery-web:lottery-web "$STATE_FILE" "$LOG_FILE" 2>/dev/null || true
}

normalize_runtime_permissions() {
  mkdir -p "$DATA_DIR" "$PACKAGE_DIR"
  chown lottery-web:lottery-web "$DATA_DIR" "$PACKAGE_DIR" || return 1
  for name in lottery.db .encryption-key update-state.json update.log; do
    if [ -e "$DATA_DIR/$name" ]; then
      chown lottery-web:lottery-web "$DATA_DIR/$name" || return 1
    fi
  done
  [ ! -f "$DATA_DIR/lottery.db" ] || chmod 640 "$DATA_DIR/lottery.db"
  [ ! -f "$DATA_DIR/.encryption-key" ] || chmod 600 "$DATA_DIR/.encryption-key"
}

restore_data() {
  for name in lottery.db .encryption-key; do
    if [ -f "$BACKUP_DIR/$name" ]; then cp -f "$BACKUP_DIR/$name" "$DATA_DIR/$name"; fi
  done
  normalize_runtime_permissions
}

rollback() {
  local reason="$1"
  log "更新失败: $reason"
  if [ -n "$OLD_COMMIT" ]; then
    git -C "$APP_DIR" reset --hard "$OLD_COMMIT" || true
  fi
  restore_data
  normalize_runtime_permissions || log "警告: 恢复文件权限失败"
  cd "$APP_DIR" || true
  npm ci --no-audit --no-fund || true
  npm run web:typecheck || true
  npm run web:build || true
  systemctl restart "$SERVICE_NAME" || true
  write_state failed "$reason" true "$OLD_DEPLOYED_COMMIT"
  log "已回滚到 $OLD_COMMIT"
  exit 1
}

log "开始更新"
if [ ! -d "$APP_DIR/.git" ]; then rollback "项目目录不是 Git 仓库"; fi
if [ -n "$(git -C "$APP_DIR" status --porcelain)" ]; then rollback "工作区存在未提交修改"; fi

OLD_COMMIT="$(git -C "$APP_DIR" rev-parse HEAD)"
OLD_DEPLOYED_COMMIT="$(UPDATE_STATE_FILE="$STATE_FILE" UPDATE_OLD_COMMIT="$OLD_COMMIT" node - <<'NODE'
const fs = require('fs');
let value = {};
try { value = JSON.parse(fs.readFileSync(process.env.UPDATE_STATE_FILE, 'utf8')); } catch {}
const deployed = String(value.deployedCommit || '');
process.stdout.write(/^[a-f0-9]{40}$/i.test(deployed) ? deployed : process.env.UPDATE_OLD_COMMIT);
NODE
)"
write_state running "" false
cp -f "$DATA_DIR/lottery.db" "$BACKUP_DIR/lottery.db" 2>/dev/null || true
cp -f "$DATA_DIR/.encryption-key" "$BACKUP_DIR/.encryption-key" 2>/dev/null || true
normalize_runtime_permissions || rollback "无法设置数据库和加密密钥权限"

if [ ! -f "$PACKAGE_FILE" ] || [ ! -f "$PACKAGE_METADATA" ]; then rollback "未找到本地发布包，请先在控制台上传"; fi
PACKAGE_MODE="true"
prepare_local_package
log "使用本地上传发布包: $NEW_COMMIT"
deploy_archive "$PACKAGE_FILE"

cd "$APP_DIR" || rollback "无法进入项目目录"
npm ci --no-audit --no-fund || rollback "安装依赖失败"
npm run web:typecheck || rollback "TypeScript 检查失败"
npm run web:build || rollback "前端构建失败"
systemctl restart "$SERVICE_NAME" || rollback "重启服务失败"
systemctl is-active --quiet "$SERVICE_NAME" || rollback "systemd 服务未运行"
wait_for_url http://127.0.0.1:6666/ || rollback "6666 健康检查失败"
wait_for_url http://127.0.0.1:8080/ || rollback "8080 代理检查失败"
test "$(curl -sS --max-time 15 -o /dev/null -w '%{http_code}' http://127.0.0.1:6666/api/auth/me)" = "401" || rollback "未登录鉴权检查失败"
normalize_runtime_permissions || rollback "部署后无法设置运行文件权限"

write_state success "" false "$NEW_COMMIT"
if [ "$PACKAGE_MODE" = "true" ]; then
  mv -f "$PACKAGE_FILE" "$BACKUP_DIR/release.tar.gz"
  mv -f "$PACKAGE_METADATA" "$BACKUP_DIR/release.json"
fi
log "更新成功: $NEW_COMMIT"
